# La app llama a la API en su mismo origen (/api/v1): Vite la reenvía en desarrollo
# (API_PROXY_TARGET, por defecto http://localhost:3001) y Vercel en producción (vercel.json).
# Así funciona la cookie de sesión httpOnly. Solo cambia esto si sabes lo que haces.
VITE_API_URL=/api/v1

# Modo demo (solo desarrollo): `npm run dev:demo` usa una API simulada en memoria.
# Usuarios de ejemplo: dueno@demo.bo, admin@demo.bo, mesero@demo.bo, cajero@demo.bo, chef@demo.bo
# Contraseña de todos: Demo1234
